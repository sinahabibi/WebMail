@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Loc
@model ServerConfig
@{
    Layout = null;
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture;
    var isRtl = currentCulture.TextInfo.IsRightToLeft;
    var dir = isRtl ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@currentCulture.TwoLetterISOLanguageName" dir="@dir" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Loc["app_name"] - @Loc["setup_title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        darkMode: 'class',
        theme: {
        extend: {
        fontFamily: { sans: ['Inter', 'sans-serif'] },
        colors: {
        brand: { 50: '#eef2ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 900: '#312e81' }
        }
        }
        }
        }
    </script>
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }

        ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
        }

        ::-webkit-scrollbar-track {
        background: transparent;
        }

        ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
        }

        .dark ::-webkit-scrollbar-thumb {
        background: #475569;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-slate-900 dark:text-gray-100 min-h-screen flex flex-col items-center justify-center p-4">

    <div class="w-full max-w-3xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl p-6 sm:p-10 z-10 relative shadow-sm">

        <div class="flex flex-col items-center mb-8">
            <div class="flex items-center gap-2 text-brand-600 dark:text-brand-500">
                <i class="ph-fill ph-paper-plane-tilt text-4xl"></i>
                <span class="text-3xl font-bold tracking-tight">@Loc["app_name"]</span>
            </div>

            <div class="flex items-center gap-6 mt-5 mb-2 bg-gray-50/80 dark:bg-slate-900/40 px-5 py-2.5 rounded-xl border border-gray-100 dark:border-slate-700/50">

                <button type="button" data-provider="gmail" title="Google / Gmail" class="provider-shortcut opacity-85 hover:opacity-100 transition-opacity duration-200 flex items-center outline-none">
                    <svg class="w-9 h-9" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.85z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.85c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                </button>

                <span class="w-[1px] h-5 bg-gray-200 dark:bg-slate-700"></span>

                <button type="button" data-provider="outlook" title="Outlook" class="provider-shortcut opacity-85 hover:opacity-100 transition-opacity duration-200 flex items-center outline-none">
                    <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#0078D4" />
                    </svg>
                </button>

                <span class="w-[1px] h-5 bg-gray-200 dark:bg-slate-700"></span>

                <button type="button" data-provider="yahoo" title="Yahoo" class="provider-shortcut opacity-85 hover:opacity-100 transition-opacity duration-200 flex items-center outline-none">
                    <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.5 3h3.5l4 6 4-6h3.5L14 11v10h-4V11L4.5 3zM19.5 13.5c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5-1.5-.7-1.5-1.5.7-1.5 1.5-1.5z" fill="#6001d2" />
                    </svg>
                </button>
            </div>

            <h1 class="text-xl font-bold text-gray-800 dark:text-gray-100 mt-4">@Loc["setup_title"]</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 text-center mt-2">
                @Loc["setup_subtitle"]
            </p>
        </div>

        <form method="post" asp-action="Index" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-3 rounded-lg text-sm mb-4 border border-red-100 dark:border-red-900/30 font-medium"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4 p-5 border border-gray-100 dark:border-slate-700 rounded-lg bg-gray-50/50 dark:bg-slate-800/50">
                    <div class="flex items-center gap-2 text-gray-800 dark:text-gray-200 font-bold mb-3 border-b border-gray-200 dark:border-slate-600 pb-2">
                        <i class="ph-fill ph-download-simple text-xl text-brand-500"></i>
                        <h3>@Loc["imap_title"]</h3>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">@Loc["server_address"]</label>
                        <input type="text" asp-for="ImapServer" id="ImapServer" placeholder="imap.example.com" class="w-full bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg py-2.5 px-3 text-sm outline-none focus:border-brand-500 transition-colors" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">@Loc["port"]</label>
                        <input type="number" asp-for="ImapPort" id="ImapPort" placeholder="993" class="w-full bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg py-2.5 px-3 text-sm outline-none focus:border-brand-500 transition-colors" required>
                    </div>
                </div>

                <div class="space-y-4 p-5 border border-gray-100 dark:border-slate-700 rounded-lg bg-gray-50/50 dark:bg-slate-800/50">
                    <div class="flex items-center gap-2 text-gray-800 dark:text-gray-200 font-bold mb-3 border-b border-gray-200 dark:border-slate-600 pb-2">
                        <i class="ph-fill ph-upload-simple text-xl text-brand-500"></i>
                        <h3>@Loc["smtp_title"]</h3>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">@Loc["server_address"]</label>
                        <input type="text" asp-for="SmtpServer" id="SmtpServer" placeholder="smtp.example.com" class="w-full bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg py-2.5 px-3 text-sm outline-none focus:border-brand-500 transition-colors" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">@Loc["port"]</label>
                        <input type="number" asp-for="SmtpPort" id="SmtpPort" placeholder="465" class="w-full bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg py-2.5 px-3 text-sm outline-none focus:border-brand-500 transition-colors" required>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3 px-1 pt-2">
                <input type="checkbox" asp-for="UseSsl" id="UseSsl" class="w-5 h-5 rounded border-gray-300 text-brand-600 focus:ring-brand-500" checked>
                <label class="text-sm font-bold text-gray-700 dark:text-gray-300 select-none">@Loc["require_ssl"]</label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                <button type="button" id="test-btn" class="w-full bg-gray-200 hover:bg-gray-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-gray-800 dark:text-gray-200 rounded-xl py-3.5 px-4 font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="ph-bold ph-plugs"></i>
                    <span>@Loc["test_connection"]</span>
                </button>

                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white rounded-xl py-3.5 px-4 font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="ph-bold ph-check-circle text-xl"></i>
                    <span>@Loc["save_continue"]</span>
                </button>
            </div>
        </form>
    </div>

<form asp-controller="Home" asp-action="ChangeLanguage" method="post" class="mt-8 flex items-center gap-4 text-sm font-medium">
    <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />

    <button type="submit" name="culture" value="fa" class="text-gray-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors bg-transparent border-none p-0 cursor-pointer" dir="rtl">
        فارسی
    </button>
    
    <span class="text-gray-300 dark:text-gray-600">|</span>
    
    <button type="submit" name="culture" value="en" class="text-gray-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors bg-transparent border-none p-0 cursor-pointer" dir="ltr">
        English
    </button>
</form>

    <div id="test-modal" class="fixed inset-0 z-50 hidden flex-col items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl w-full max-w-sm p-6 relative">

            <div id="modal-loading" class="flex flex-col items-center justify-center py-6">
                <i class="ph ph-spinner-gap animate-spin text-4xl text-brand-500 mb-4"></i>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">@Loc["testing_connection"]</h3>
                <p class="text-sm text-gray-500 mt-2 text-center">@Loc["testing_wait_msg"]</p>
            </div>

            <div id="modal-result" class="hidden flex-col items-center justify-center py-4">
                <div id="result-icon" class="text-5xl mb-4"></div>
                <h3 id="result-title" class="text-lg font-bold text-gray-900 dark:text-white text-center"></h3>
                <div class="bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-lg p-3 mt-4 w-full">
                    <p id="result-message" class="text-sm text-gray-600 dark:text-gray-400 text-center"></p>
                </div>
                <button type="button" id="close-modal-btn" class="mt-6 w-full bg-gray-200 hover:bg-gray-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-gray-800 dark:text-gray-200 rounded-lg py-2.5 font-bold transition-colors">
                    @Loc["close"]
                </button>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
        // تنظیم دارک مود
        const html = document.documentElement;
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
        }

        // دیتاهای مربوط به سرورهای معروف
        const providerSettings = {
        gmail: { imap: 'imap.gmail.com', imapPort: 993, smtp: 'smtp.gmail.com', smtpPort: 465 },
        outlook: { imap: 'outlook.office365.com', imapPort: 993, smtp: 'smtp-mail.outlook.com', smtpPort: 587 },
        yahoo: { imap: 'imap.mail.yahoo.com', imapPort: 993, smtp: 'smtp.mail.yahoo.com', smtpPort: 465 }
        };

        // هندل کردن کلیک روی شورت‌کات‌ها
        document.querySelectorAll('.provider-shortcut').forEach(btn => {
        btn.addEventListener('click', () => {
        const provider = btn.getAttribute('data-provider');
        if(providerSettings[provider]) {
        document.getElementById('ImapServer').value = providerSettings[provider].imap;
        document.getElementById('ImapPort').value = providerSettings[provider].imapPort;
        document.getElementById('SmtpServer').value = providerSettings[provider].smtp;
        document.getElementById('SmtpPort').value = providerSettings[provider].smtpPort;
        }
        });
        });

        // کدهای مربوط به تست ارتباط
        const testBtn = document.getElementById('test-btn');
        const modal = document.getElementById('test-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const loadingState = document.getElementById('modal-loading');
        const resultState = document.getElementById('modal-result');

        const resultIcon = document.getElementById('result-icon');
        const resultTitle = document.getElementById('result-title');
        const resultMessage = document.getElementById('result-message');

        closeModalBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        });

        testBtn.addEventListener('click', async () => {
        const payload = {
        ImapServer: document.getElementById('ImapServer').value,
        ImapPort: parseInt(document.getElementById('ImapPort').value) || 0,
        SmtpServer: document.getElementById('SmtpServer').value,
        SmtpPort: parseInt(document.getElementById('SmtpPort').value) || 0,
        UseSsl: document.getElementById('UseSsl').checked
        };

        if (!payload.ImapServer || !payload.ImapPort || !payload.SmtpServer || !payload.SmtpPort) {
        alert("@Loc["fill_all_fields"]");
        return;
        }

        loadingState.classList.remove('hidden');
        loadingState.classList.add('flex');
        resultState.classList.add('hidden');
        resultState.classList.remove('flex');

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        try {
        const response = await fetch('/Setup/TestConnectionApi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
        });
        const data = await response.json();

        loadingState.classList.add('hidden');
        loadingState.classList.remove('flex');
        resultState.classList.remove('hidden');
        resultState.classList.add('flex');

        resultTitle.textContent = data.title;
        resultMessage.textContent = data.message;

        if (data.success) {
        resultIcon.innerHTML = '<i class="ph-fill ph-check-circle text-green-500"></i>';
        } else {
        resultIcon.innerHTML = '<i class="ph-fill ph-warning-circle text-red-500"></i>';
        }

        } catch (error) {
        loadingState.classList.add('hidden');
        loadingState.classList.remove('flex');
        resultState.classList.remove('hidden');
        resultState.classList.add('flex');

        resultIcon.innerHTML = '<i class="ph-fill ph-x-circle text-red-500"></i>';
        resultTitle.textContent = "@Loc["network_error"]";
        resultMessage.textContent = "@Loc["network_error_msg"]";
        }
        });
        });
    </script>
</body>
</html>